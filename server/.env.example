# Server environment variables
# Copy this to .env and fill in your values

# MongoDB connection string
# Local: mongodb://localhost:27017/geniusbot
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/geniusbot
MONGODB_URI=mongodb://localhost:27017/geniusbot

# Google Gemini API key (get one free at https://aistudio.google.com/apikey)
# Leave empty to use stub/mock responses — the app works without it
GEMINI_API_KEY=

# Server port
PORT=3001

# Environment: development | production
NODE_ENV=development

# Allowed CORS origin (your React dev server)
CORS_ORIGIN=http://localhost:5173
